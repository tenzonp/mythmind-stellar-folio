SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxkeHF0eWlweGRmZHVsaGx2ZnJ3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA4OTYzOTIsImV4cCI6MjA5NjQ3MjM5Mn0.C8hR4q2gQ0J4Utns_QiUV_5dOZzrmE39230I7cbjYAg
