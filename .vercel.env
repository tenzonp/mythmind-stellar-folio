# ---------------------------------------------------------------------------
# AI GATEWAY & LLM PROVIDERS
# ---------------------------------------------------------------------------
LOVABLE_API_KEY=
DEEPSEEK_API_KEY=

# Optional DeepSeek model overrides (defaults are fine if left empty)
DEEPSEEK_PRO_MODEL=
DEEPSEEK_FLASH_MODEL=
DEEPSEEK_REASONING_MODEL=

# ---------------------------------------------------------------------------
# TOOL INTEGRATIONS
# Missing keys degrade gracefully — the app still works, but matching features
# (Reyes, Composio, web research, PDF/deck generation) will be limited.
# ---------------------------------------------------------------------------
COMPOSIO_API_KEY=
FIRECRAWL_API_KEY=
E2B_API_KEY=

# ---------------------------------------------------------------------------
# PAYMENTS (Dodo Payments) — Required if you accept payments
# ---------------------------------------------------------------------------
DODO_API_KEY=
DODO_ENV=test
DODO_PRODUCT_ID_PRO=
DODO_PRODUCT_ID_EVEREST=
DODO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# PHONE AUTH (Aakash SMS) — Required for Nepal phone-number OTP login
# ---------------------------------------------------------------------------
AAKASH_SMS_TOKEN=

# ---------------------------------------------------------------------------
# OPTIONAL / ADVANCED
# ---------------------------------------------------------------------------
# SESSION_SECRET=          # Only needed if you use TanStack useSession cookies
# NODE_ENV=production      # Vercel sets this automatically — no need to add
